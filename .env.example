# Firebase Client Variables
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Brapi (Brazilian market data) — free token, sign up at https://brapi.dev
# Without this, Graham valuation model will show N/A for all BR assets
# (fundamental=true does not include priceToBookRatio; the real P/VP and
# BVPS live in the defaultKeyStatistics module, which requires a token even
# on the free plan for any ticker outside PETR4/MGLU3/VALE3/ITUB4).
# BRAPI_TOKEN=

# HG Brasil (Brazilian market data & corporate events) — paid plan (2 years history + payment dates)
# Without this, dividend payment dates for Brazilian equities/FIIs fall back to estimated schedules
# based on historical announcement dates and B3 calendar heuristics.
# HGBRASIL_API_KEY=

# Resend (Email Service)
# RESEND_API_KEY=
